<!DOCTYPE html>
<html lang="uk">
  <head>
    <title><%= content_for(:title) || Rails.configuration.x.shop_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <%= link_to Rails.configuration.x.shop_name, root_path, class: "navbar-brand fw-bold" %>
        <%= link_to "Каталог", cars_path, class: "nav-link text-light ms-3" %>
        <%= link_to "Контакти", new_feedback_message_path, class: "nav-link text-light ms-2" %>
        <div class="ms-auto d-flex gap-2 align-items-center">
          <% if user_signed_in? %>
            <% if current_user.admin? %>
              <%= link_to "Адміністратор", admin_root_path, class: "btn btn-danger btn-sm" %>
            <% else %>
              <div class="dropdown">
                <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false">Мій кабінет</button>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li><%= link_to "Мої замовлення", orders_path, class: "dropdown-item" %></li>
                  <li><%= link_to "Мої тест-драйви", test_drives_path, class: "dropdown-item" %></li>
                </ul>
              </div>
              <%= link_to cart_path, class: "btn btn-outline-light btn-sm" do %>
                Кошик <span class="badge text-bg-warning"><%= cart_count %></span>
              <% end %>
            <% end %>
            <span class="text-light"><%= current_user.name %></span>
            <%= button_to "Вийти", destroy_user_session_path, method: :delete, class: "btn btn-outline-light btn-sm" %>
          <% else %>
            <%= link_to "Увійти", new_user_session_path, class: "btn btn-outline-light btn-sm" %>
            <%= link_to "Реєстрація", new_user_registration_path, class: "btn btn-warning btn-sm" %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="container py-4">
      <% if notice %><div class="alert alert-success"><%= notice %></div><% end %>
      <% if alert %><div class="alert alert-danger"><%= alert %></div><% end %>
      <%= render "admin/shared/nav" if controller_path.start_with?("admin/") %>
      <%= yield %>
    </main>
  </body>
</html>