<h1 class="mb-4">Замовлення</h1>

<% if @orders.any? %>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr><th>№</th><th>Клієнт</th><th>Автомобілі</th><th>Видача</th><th>Застава</th><th>Статус</th><th></th></tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <tr>
            <td><%= order.id %></td>
            <td><%= order.user.name %></td>
            <td><%= order.cars.map(&:full_name).join(", ") %></td>
            <td><%= order.branch.city %>, <%= l(order.pickup_at, format: "%d.%m.%Y %H:%M") %></td>
            <td><%= format_money(order.deposit_amount) %></td>
            <td><%= order_status_badge(order) %></td>
            <td class="text-end"><%= link_to "Деталі", admin_order_path(order), class: "btn btn-dark btn-sm" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="alert alert-info">Замовлень поки немає.</div>
<% end %>