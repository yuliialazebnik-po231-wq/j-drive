<%= form_with model: [ :admin, car ] do |f| %>
  <% if car.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% car.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-md-4">
      <%= f.label :brand_id, "Марка", class: "form-label" %>
      <%= f.collection_select :brand_id, @brands, :id, :name, { prompt: "Оберіть марку" }, class: "form-select" %>
    </div>
    <div class="col-md-4">
      <%= f.label :name, "Модель", class: "form-label" %>
      <%= f.text_field :name, class: "form-control" %>
    </div>
    <div class="col-md-2">
      <%= f.label :year, "Рік", class: "form-label" %>
      <%= f.number_field :year, class: "form-control" %>
    </div>
    <div class="col-md-2">
      <%= f.label :price, "Ціна, $", class: "form-label" %>
      <%= f.number_field :price, step: 1, class: "form-control" %>
    </div>

    <div class="col-md-3">
      <%= f.label :body_type, "Кузов", class: "form-label" %>
      <%= f.text_field :body_type, class: "form-control" %>
    </div>
    <div class="col-md-3">
      <%= f.label :engine, "Двигун", class: "form-label" %>
      <%= f.text_field :engine, class: "form-control" %>
    </div>
    <div class="col-md-2">
      <%= f.label :horsepower, "К.с.", class: "form-label" %>
      <%= f.number_field :horsepower, class: "form-control" %>
    </div>
    <div class="col-md-4">
      <%= f.label :transmission, "Коробка передач", class: "form-label" %>
      <%= f.text_field :transmission, class: "form-control" %>
    </div>

    <div class="col-md-4">
      <%= f.label :drive, "Привід", class: "form-label" %>
      <%= f.text_field :drive, class: "form-control" %>
    </div>
    <div class="col-md-4">
      <%= f.label :color, "Колір", class: "form-label" %>
      <%= f.text_field :color, class: "form-control" %>
    </div>
    <div class="col-md-4">
      <%= f.label :status, "Статус", class: "form-label" %>
      <%= f.select :status,
                   Car.statuses.keys.map { |s| [ CarsHelper::STATUS_LABELS[s].first, s ] },
                   {}, class: "form-select" %>
    </div>

    <div class="col-12">
      <%= f.label :description, "Опис", class: "form-label" %>
      <%= f.text_area :description, rows: 4, class: "form-control" %>
    </div>
  </div>

  <div class="mt-4 d-flex gap-2">
    <%= f.submit "Зберегти", class: "btn btn-warning" %>
    <%= link_to "Скасувати", admin_cars_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>