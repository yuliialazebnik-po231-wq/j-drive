<h1 class="mb-4">Зворотний звʼязок</h1>

<% if @messages.any? %>
  <% @messages.each do |message| %>
    <div class="card mb-3 <%= 'border-danger' unless message.handled %>">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <strong><%= message.name %></strong>
            <a href="mailto:<%= message.email %>" class="ms-2"><%= message.email %></a>
            <div class="text-muted small"><%= l(message.created_at, format: "%d.%m.%Y %H:%M") %></div>
          </div>
          <div class="d-flex gap-2 align-items-center">
            <span class="badge text-bg-<%= message.handled ? 'success' : 'danger' %>">
              <%= message.handled ? "Опрацьовано" : "Нове" %>
            </span>
            <%= button_to (message.handled ? "Повернути" : "Позначити опрацьованим"),
                          admin_feedback_message_path(message), method: :patch,
                          class: "btn btn-outline-dark btn-sm" %>
          </div>
        </div>
        <p class="mb-0 mt-3"><%= message.message %></p>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="alert alert-info">Повідомлень поки немає.</div>
<% end %>