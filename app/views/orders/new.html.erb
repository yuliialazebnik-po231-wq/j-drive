<h1 class="mb-4">Оформлення замовлення</h1>

<% messages = @order.errors.map(&:message) + @card.errors %>
<% if messages.any? %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @order, url: orders_path do |f| %>
  <div class="row g-4">
    <div class="col-lg-7">

      <div class="card mb-4">
        <div class="card-header fw-bold">1. Ваші автомобілі</div>
        <ul class="list-group list-group-flush">
          <% @items.each do |item| %>
            <li class="list-group-item d-flex justify-content-between">
              <span><%= item.car.full_name %> (<%= item.car.year %>)</span>
              <strong><%= car_price(item.car) %></strong>
            </li>
          <% end %>
          <li class="list-group-item d-flex justify-content-between bg-light">
            <span>Разом</span>
            <strong><%= format_money(@cart.total_price) %></strong>
          </li>
        </ul>
      </div>

      <div class="card mb-4">
        <div class="card-header fw-bold">2. Видача автомобіля</div>
        <div class="card-body">
          <div class="mb-3">
            <%= f.label :branch_id, "Філія салону", class: "form-label" %>
            <%= f.select :branch_id,
                         options_from_collection_for_select(@branches, :id, :full_address, @order.branch_id),
                         { prompt: "Оберіть філію" }, class: "form-select" %>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <%= label_tag :pickup_date, "Дата видачі", class: "form-label" %>
              <%= date_field_tag :pickup_date, params[:pickup_date],
                                 min: Date.tomorrow, max: Date.current + Order::MAX_PICKUP_DAYS,
                                 class: "form-control" %>
            </div>
            <div class="col-md-6">
              <%= label_tag :pickup_time, "Час видачі", class: "form-label" %>
              <%= select_tag :pickup_time,
                             options_for_select(Order::PICKUP_SLOTS, params[:pickup_time]),
                             class: "form-select" %>
            </div>
          </div>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header fw-bold">3. Сума застави</div>
        <div class="card-body">
          <p class="text-muted">
            Застава бронює авто до дня видачі. Решту суми ви сплачуєте в салоні при отриманні автомобіля.
          </p>
          <div class="d-flex flex-wrap gap-2">
            <% Order::DEPOSIT_OPTIONS.each do |amount| %>
              <%= radio_button_tag "order[deposit_amount]", amount,
                                   @order.deposit_amount.to_i == amount,
                                   id: "deposit_#{amount}", class: "btn-check" %>
              <%= label_tag "deposit_#{amount}", format_money(amount), class: "btn btn-outline-dark" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card">
        <div class="card-header fw-bold">4. Оплата заставної суми</div>
        <div class="card-body">
          <div class="alert alert-warning small">
            Навчальний проєкт: реальні гроші <strong>не списуються</strong>.
            Тестова картка: <code>4242 4242 4242 4242</code>, будь-який майбутній термін, CVV <code>123</code>.
          </div>

          <div class="mb-3">
            <%= label_tag "card_number", "Номер картки", class: "form-label" %>
            <%= text_field_tag "card[number]", nil, id: "card_number", placeholder: "4242 4242 4242 4242",
                               maxlength: 19, autocomplete: "off", class: "form-control" %>
          </div>
          <div class="mb-3">
            <%= label_tag "card_holder", "Імʼя власника", class: "form-label" %>
            <%= text_field_tag "card[holder]", @card.holder, id: "card_holder", placeholder: "IVAN PETRENKO",
                               autocomplete: "off", class: "form-control" %>
          </div>
          <div class="row g-3 mb-4">
            <div class="col-6">
              <%= label_tag "card_expiry", "Термін дії", class: "form-label" %>
              <%= text_field_tag "card[expiry]", nil, id: "card_expiry", placeholder: "ММ/РР",
                                 maxlength: 5, autocomplete: "off", class: "form-control" %>
            </div>
            <div class="col-6">
              <%= label_tag "card_cvv", "CVV", class: "form-label" %>
              <%= password_field_tag "card[cvv]", nil, id: "card_cvv", placeholder: "123",
                                     maxlength: 3, autocomplete: "off", class: "form-control" %>
            </div>
          </div>

          <%= f.submit "Сплатити заставу", class: "btn btn-warning btn-lg w-100" %>
        </div>
      </div>
    </div>
  </div>
<% end %>