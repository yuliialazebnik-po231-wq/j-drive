<div class="row justify-content-center py-4">
  <div class="col-md-6 col-lg-5">
    <div class="card auth-card">
      <div class="card-body p-4 p-md-5">
        <h2 class="text-center mb-1">Вхід</h2>
        <p class="text-center text-muted mb-4">Раді бачити вас у <%= Rails.configuration.x.shop_name %></p>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="mb-3">
            <%= f.label :email, "Email", class: "form-label" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email",
                              placeholder: "name@example.com", class: "form-control form-control-lg" %>
          </div>

          <div class="mb-3">
            <%= f.label :password, "Пароль", class: "form-label" %>
            <%= f.password_field :password, autocomplete: "current-password",
                                 class: "form-control form-control-lg" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="form-check mb-4">
              <%= f.check_box :remember_me, class: "form-check-input" %>
              <%= f.label :remember_me, "Запамʼятати мене", class: "form-check-label" %>
            </div>
          <% end %>

          <%= f.submit "Увійти", class: "btn btn-warning btn-lg w-100" %>
        <% end %>

        <hr class="my-4">
        <p class="text-center mb-0">
          Немає акаунта? <%= link_to "Зареєструватися", new_user_registration_path, class: "fw-semibold" %>
        </p>
      </div>
    </div>
  </div>
</div>