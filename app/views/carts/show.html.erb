<h1 class="mb-4">Кошик</h1>

<% if @items.any? %>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Автомобіль</th>
          <th>Рік</th>
          <th>Статус</th>
          <th class="text-end">Ціна</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @items.each do |item| %>
          <tr>
            <td><%= link_to item.car.full_name, car_path(item.car), class: "fw-bold text-decoration-none" %></td>
            <td><%= item.car.year %></td>
            <td><%= car_status_badge(item.car) %></td>
            <td class="text-end"><%= car_price(item.car) %></td>
            <td class="text-end">
              <%= button_to "Видалити", cart_item_path(item), method: :delete,
                            class: "btn btn-outline-danger btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <th colspan="3" class="text-end">Разом:</th>
          <th class="text-end fs-5"><%= format_money(@cart.total_price) %></th>
          <th></th>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="d-flex justify-content-between">
    <%= link_to "← Продовжити перегляд", cars_path, class: "btn btn-outline-secondary" %>
    <button class="btn btn-warning btn-lg" disabled>Оформити замовлення (скоро)</button>
  </div>
<% else %>
  <div class="alert alert-info">Ваш кошик порожній.</div>
  <%= link_to "Перейти до каталогу", cars_path, class: "btn btn-warning" %>
<% end %>